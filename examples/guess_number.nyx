x+++++
y+++
xx[*!] xy[*!]
# making word FAIL
x+ x?  # x = L:, push to mem
x--- x?  # x = I:, push to mem
x--- x?  # x = F:, push to mem
x----- x?  # x = A:, push to mem
~  # swap A and F

# WIN
x+++++++++++++ x?  # x = N:, push to mem
x----- x?  # x = I:, push to mem
x++++++++++++++ x?  # x = W:, push to mem

# Random number between 1 and 3
a++  # a = 2
a$  # a = 0..2
a+  # a = 1..3

b&  # get input number
# if input == random number
a=b(
  !: !: !:  # WIN
  |  # else
  _ _ _  # skip WIN
  !: !: !: !:  # FAIL
)
