{
  "name": "nyxium",
  "version": "1.0.0",
  "description": "Nyxium programming language",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "nyx": "./dist/nyxium.min.mjs"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "build": "node ./scripts/build-single.mjs --minify",
    "build:single": "node ./scripts/build-single.mjs",
    "build:dev": "tsc",
    "build:web": "node ./scripts/build-web.mjs --minify",
    "start": "node dist/index.js",
    "test": "node --import tsx --test tests/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}